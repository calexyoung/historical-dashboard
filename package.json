{
  "name": "macro-atlas",
  "private": true,
  "description": "Macro Atlas v2 workspace (TypeScript side). The Python side is atlas/ with pyproject.toml.",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-schema.mjs && node scripts/gen-rights.mjs",
    "gen:check": "node scripts/gen-schema.mjs --check && node scripts/gen-rights.mjs --check",
    "lint": "eslint && npm run lint -w @macro-atlas/site",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "as-of": "node scripts/as-of.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24.19.2",
    "eslint": "^9",
    "json-schema-to-typescript": "^15",
    "rolldown": "^1.2.19",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.1.0"
  }
}
