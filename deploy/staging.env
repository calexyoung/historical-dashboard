# The staging build (PLAN 4.8 and 6.1; deploy/RUNBOOK.md). Read by deploy/compose.yaml and by
# the scripts beside it. No secret belongs in this file: it is committed. The API keys and the
# host's own choices are in the file ATLAS_SERVER_ENV names, on the server only.
ATLAS_SURFACE=staging
BASE_PATH=/macro-atlas-staging
ATLAS_WEB_PORT=3102
ATLAS_DATA_DIR=/srv/macro-atlas/staging
ATLAS_BACKUP_DIR=/srv/macro-atlas/backups/staging
ATLAS_SERVER_ENV=/srv/macro-atlas/env/staging.env
