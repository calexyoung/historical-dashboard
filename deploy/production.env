# The production build (PLAN 4.8 and 6.1; deploy/RUNBOOK.md). Read by deploy/compose.yaml and by
# the scripts beside it. No secret belongs in this file: it is committed. The API keys and the
# host's own choices are in the file ATLAS_SERVER_ENV names, on the server only.
ATLAS_SURFACE=production
BASE_PATH=/macro-atlas
ATLAS_WEB_PORT=3101
ATLAS_DATA_DIR=/srv/macro-atlas/production
ATLAS_BACKUP_DIR=/srv/macro-atlas/backups/production
ATLAS_SERVER_ENV=/srv/macro-atlas/env/production.env
