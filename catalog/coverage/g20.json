{
  "format": 1,
  "title": "The headline indicators of the nineteen G20 countries and the euro area",
  "about": "What Macro Atlas holds for each of the nineteen countries of the G20 and for the euro area, indicator by indicator, and why anything is missing. Consumer prices, inflation and exchange rates are M14's (the International Monetary Fund's SDMX API). The other columns show what the Catalog declares today, mostly v1's series as drafts, and what the plan schedules for the rest. The European Union and the African Union are members of the G20 and have no row: the brief's table is of economies with a currency and a price index of their own.",
  "columns": [
    {
      "id": "cpi",
      "name": "Consumer prices (index)"
    },
    {
      "id": "inflation",
      "name": "Inflation (y/y)"
    },
    {
      "id": "fx",
      "name": "Currency per U.S. dollar (monthly)"
    },
    {
      "id": "policy_rate",
      "name": "Policy or short-term interest rate",
      "default": {
        "none": "Planned from the Bank for International Settlements' policy-rate dataset, which carries eighteen G20 economies and the euro area.",
        "waits_for": "M36"
      }
    },
    {
      "id": "unemployment",
      "name": "Unemployment rate",
      "default": {
        "none": "Monthly unemployment is planned from the OECD and national statistics offices. The IMF's labour dataflow was stale or absent for several members when it was looked at on 2026-11-11.",
        "waits_for": "M36"
      }
    },
    {
      "id": "gdp_growth",
      "name": "GDP growth",
      "default": {
        "none": "Planned from the IMF World Economic Outlook, annual, with observed and projected values kept apart.",
        "waits_for": "M37"
      }
    },
    {
      "id": "stock_index",
      "name": "Main stock index",
      "default": {
        "none": "Index levels are licensed by their publishers and no free publishable source is known; the recommendation under decision D5, which is open, is to show the row as withheld with a link to each exchange.",
        "waits_for": "D5"
      }
    }
  ],
